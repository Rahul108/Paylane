# ==============================================================================
# Docker Deployment Environment Template (deploy/.env.example)
# Used for Docker Compose container ports and orchestration variables.
# No sensitive production credentials are kept here.
# ==============================================================================

# Infrastructure Port Mappings (Host Localhost)
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=change_this_root_password
REDIS_PORT=6381

# Microservice Host Port Bindings (> 3005, > 4005, > 5005)
WEB_PORT=3010
ORCHESTRATOR_PORT=4010
PAYMENT_CORE_PORT=4011
MOCK_MFS_PORT=5011
MOCK_CARD_PORT=5012
MOCK_DOWNSTREAM_PORT=5013
